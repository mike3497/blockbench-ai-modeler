		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"blockbench-types": "^5.2.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
