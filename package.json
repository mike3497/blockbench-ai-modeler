{
	"name": "blockbench-ai-modeler",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A Blockbench plugin for AI-assisted cube modeling.",
	"scripts": {
		"build": "npm run typecheck && vite build",
		"watch": "vite build --watch",
